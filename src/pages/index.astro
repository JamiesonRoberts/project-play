</Layout>

<style>
  .header,
  .main,
  .footer {
    max-width: 75rem;
    margin: 0 auto;
    padding: 1rem 2rem;
    position: relative;
    z-index: 2;
  }

  .header {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    padding: 3rem 0;

    .text {
      font-size: 1.875rem;
    }

    .subText {
      font-size: 0.5em;
      display: flex;
      font-weight: normal;
      justify-content: space-between;
      padding-right: 0.3rem;
    }
  }

  .main {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section {
    position: relative;
    padding: 1rem;
    backdrop-filter: blur(0.25rem);
  }

  .footer {
    padding: 3rem 0;
    font-size: 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;

    .footerRow {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
    }

    .externalLinkList {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      padding-left: 0;
      gap: 1rem;
    }

    .externalLinkSVGIcon {
      height: 2rem;
      width: auto;
    }

    .footerSVG {
      width: 1.75rem;
    }
  }
</style>
